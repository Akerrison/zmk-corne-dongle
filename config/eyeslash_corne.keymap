/ {
    macros {
        LOG_BOX: LOG_BOX {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp RA(UP_ARROW)>,
                <&macro_wait_time 200>,
                <&kp F2>,
                <&macro_wait_time 200>,
                <&kp LS(L) &kp LS(O) &kp LS(G) &kp SPACE &kp LS(B) &kp LS(O) &kp LS(X) &kp RET>;

            label = "LOG_BOX";
            wait-ms = <40>;
            tap-ms = <40>;
        };

        SERIAL_NUMBER: SERIAL_NUMBER {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = 
                <&kp RA(T)>, 
                <&kp UP_ARROW>, 
                <&kp UP_ARROW>, 
                <&kp UP_ARROW>,
                <&kp UP_ARROW>, 
                <&kp RET>;
            label = "SERIAL_NUMBER";
            wait-ms = <40>;
            tap-ms = <40>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  ESC |  Q  |  W  |  F   |  P   |  B  |     |  J     |  L   |  U  |  Y  |  ;  | DEL  |
            // |  TAB |  A  |  R  |  S   |  T   |  G  |     |  M     |  N   |  E  |  I  |  O  |  '   |
            // | SHFT |  Z  |  X  |  C   |  D   |  V  |     |  K     |  H   |  ,  |  .  |  /  | BSPC |
            //                    | CTRL | SHFT | ENT/1 |   | BSPC/2 | SPC  | ALT |

            bindings = <
&kp ESC  &kp Q  &kp W       &kp F           &kp P        &kp B             &kp J            &kp L            &kp U                    &kp Y    &kp SEMI  &kp DEL
&kp TAB  &kp A  &kp R       &kp S           &kp T        &kp G             &kp M            &kp N            &kp E                    &kp I    &kp O     &kp SQT
&mo 3    &kp Z  &mt LGUI X  &mt LCTRL C     &mt LALT D   &kp V             &kp K            &mt RIGHT_ALT H  &mt RIGHT_CONTROL COMMA  &kp DOT  &kp FSLH  &kp BSPC
                            &kp LEFT_SHIFT  &lt 5 SPACE  &lt 1 RET        &lt 2 BACKSPACE  &lt 5 SPACE      &kp RIGHT_SHIFT
            >;
        };

        Navigate_Layer {
            // -----------------------------------------------------------------------------------------
            // | ESC    | CUT   | COPY         | UP   | PASTE_NF | PASTE   |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | ALT_TAB| UNDO  | LEFT         | DOWN | RIGHT    | ALT_TAB |   | LFT | DWN |  UP | RGT |     |      |
            // | DEL    | PRTSC | CURRENT_TIME | END  | HOME     | URL     |   |     |     |     |     |     |      |
            //                                 |      |          |         |   | ENT |     | ALT |

            bindings = <
&SERIAL_NUMBER  &kp LC(X)      &kp LC(C)         &kp UP    &kp LC(LS(V))  &kp LC(V)      &mkp MB4   &msc SCRL_UP    &mmv MOVE_UP    &trans           &trans           &trans
&LOG_BOX       &kp LC(Z)      &kp LEFT          &kp DOWN  &kp RIGHT      &kp LA(TAB)    &kp F5     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp LC(TAB)      &trans
&kp BACKSPACE  &kp LG(LS(S))  &kp LC(LS(SEMI))  &kp END   &kp HOME       &kp LC(L)      &mkp MB5   &msc SCRL_DOWN  &msc SCRL_LEFT  &msc SCRL_RIGHT  &kp LC(LS(TAB))  &trans
                                                &trans    &trans         &trans         &mkp LCLK  &mkp MCLK       &mkp RCLK
            >;
        };

        NumberPad {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp BACKSLASH    &kp ASTERISK  &kp N7  &kp N8    &kp N9  &kp EQUAL                &kp EQUAL  &kp N7        &kp N8        &kp N9        &kp ASTERISK      &kp BACKSLASH
&kp GRAVE  &kp SLASH  &kp N4  &kp N5    &kp N6  &kp MINUS    &kp MINUS  &kp N4  &kp N5        &kp N6  &kp SLASH         &kp GRAVE
&kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp N1  &kp N2    &kp N3  &kp N0               &kp N0     &kp N1  &kp N2  &kp N3  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
                           &trans    &trans  &trans                &trans     &kp RCTRL     &kp RALT
            >;
        };

        System {
            bindings = <
&sys_reset  &bootloader   &trans        &studio_unlock       &out OUT_USB            &out OUT_BLE           &trans  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans      &bootloader  &sys_reset
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3     &bt BT_SEL 4    &trans  &kp C_PREVIOUS        &kp C_PLAY_PAUSE      &kp C_NEXT  &to 4       &trans
&trans      &trans        &kp C_MUTE    &kp C_VOL_DN  &kp C_VOLUME_UP  &trans          &trans  &trans                &trans                &trans      &trans       &trans
                                        &trans        &trans           &trans          &trans  &trans                &trans
            >;
        };

        Media {
            bindings = <
&trans  &trans  &trans  &mmv MOVE_UP  &trans  &trans    &kp C_AL_WWW           &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans           &trans  &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN      &mmv MOVE_RIGHT      &to 0    &kp C_AL_CALCULATOR    &kp C_PREVIOUS        &kp C_PLAY_PAUSE      &kp C_NEXT       &trans  &trans
&trans  &trans  &trans  &trans               &trans                 &trans    &kp C_AL_FILE_BROWSER  &kp C_MUTE            &kp C_VOL_DN          &kp C_VOLUME_UP  &trans  &trans
                        &trans               &mkp LCLK                 &mkp RCLK    &trans                 &trans                &trans
            >;
        };

        One_handed {
            bindings = <
&kp DELETE     &kp SEMI   &kp Y       &kp U      &kp L   &kp J     &kp B   &kp P  &kp tfztfzertss   &kp W  &kp Q  &kp ESC
&kp SQT        &kp O      &kp I       &kp E      &kp N   &kp M     &kp G   &kp T  &kp S   &kp R  &kp A  &kp TAB
&kp BACKSPACE  &kp SLASH  &kp PERIOD  &kp COMMA  &kp H   &kp K     &kp V   &kp D  &kp C   &kp X  &kp Z  &kp ENTER
                                      &trans     &trans  &trans    &trans  &none  &trans
            >;
        };

    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};